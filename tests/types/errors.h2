new class Opaque { n: int }
new function strings() {
    print(Opaque(1))
    let s = string(Opaque(1))
    let t: string = "literal"
}
new class BadConv {
    n: int
    new operator string (b: BadConv) -> int { return 1 }
}

new class Counter {
    count: int
    new function peek() -> int { return self.count }
    new function sneaky() { self.count = 9 }          // not mut: can't change self
    new mut function bump() { self.count += 1 }
    new function calls_mut() { self.bump() }          // not mut: can't call a mut method on self
}

new function use_counter(param: Counter) {
    let fixed = Counter(0)
    fixed.bump()                                       // let: can't call mut
    param.bump()                                       // parameter: can't call mut
    var changing = Counter(0)
    changing.bump()                                    // fine
    Counter(1).bump()                                  // fine: a temporary
    let p = alloc Counter(2)
    p.bump()                                           // fine: through a pointer
    free p
}

new function inc(n: var int) { n += 1 }
new function var_errors(param: int) {
    let fixed = 1
    inc(fixed)          // let can't be changed
    inc(param)          // parameter can't be changed
    inc(5)              // not a variable
    var ok = 1
    inc(ok)             // fine
}
