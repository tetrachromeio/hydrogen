new function control(x: int) -> int {
    var i: int
    var total = 0
    if x > 5 { total = 1 } else if x > 2 { total = 2 } else { total = 3 }
    while i < 10 { i += 1; total -= 1 }
    for k in 0..10 {
        if k == 3 { continue }
        if k == 8 { break }
        total *= k
    }
    total >>= 1
    total <<= 2
    total |= 0xFF
    total &= 0b1010
    let flags = x & 1 == 0
    let neg = -x + !true
    let long = 1_000_000 + 0o17 + 3.14 + 1e9 + 2.5e-3
    let sum = total +
              x
    let chained = list
        .first()
        .value
    asm { "mov rax, 1" "syscall" }
    return total
}

