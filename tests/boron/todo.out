[boron] window "To Do" 420x360
[boron] css
.bn-item { display: flex; align-items: center; gap: 8px; min-height: 26px }
[boron] render
<h1>To Do</h1><p class="bn-caption">0 of 0 left</p><div class="bn-row"><input type="text" class="bn-grow" data-bn="draft" value="" placeholder="What needs doing?"><button data-bn="add" data-bn-click disabled>Add</button></div><div class="bn-card"><p class="bn-caption">Nothing yet.</p></div>
[boron] event input draft Buy milk
[boron] render
<h1>To Do</h1><p class="bn-caption">0 of 0 left</p><div class="bn-row"><input type="text" class="bn-grow" data-bn="draft" value="Buy milk" placeholder="What needs doing?"><button data-bn="add" data-bn-click class="bn-accent">Add</button></div><div class="bn-card"><p class="bn-caption">Nothing yet.</p></div>
[boron] event submit draft Buy milk
[boron] render
