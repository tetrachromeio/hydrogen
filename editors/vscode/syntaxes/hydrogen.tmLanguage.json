{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Hydrogen",
  "scopeName": "source.hydrogen",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.hydrogen", "match": "//.*$" },
        { "name": "comment.block.hydrogen", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.hydrogen",
          "begin": "\"", "end": "\"",
          "patterns": [{ "name": "constant.character.escape.hydrogen", "match": "\\\\(x[0-9A-Fa-f]{2}|[ntr0\\\\'\"])" }]
        },
        { "name": "string.quoted.single.hydrogen", "match": "'(\\\\(x[0-9A-Fa-f]{2}|[ntr0\\\\'\"])|[^'\\\\])'" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(new)\\s+(mut\\s+)?(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.hydrogen" },
            "2": { "name": "storage.modifier.hydrogen" },
            "3": { "name": "keyword.declaration.function.hydrogen" },
            "4": { "name": "entity.name.function.hydrogen" }
          }
        },
        {
          "match": "\\b(new)\\s+(type|class|enum|interface)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.hydrogen" },
            "2": { "name": "keyword.declaration.type.hydrogen" },
            "3": { "name": "entity.name.type.hydrogen" }
          }
        },
        {
          "match": "\\b(new)\\s+(operator)\\s+([^\\s(]+)",
          "captures": {
            "1": { "name": "keyword.declaration.hydrogen" },
            "2": { "name": "keyword.declaration.function.hydrogen" },
            "3": { "name": "entity.name.function.operator.hydrogen" }
          }
        },
        {
          "match": "\\b(extern)\\s+(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.hydrogen" },
            "2": { "name": "keyword.declaration.function.hydrogen" },
            "3": { "name": "entity.name.function.hydrogen" }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.hydrogen" },
            "2": { "name": "variable.other.constant.hydrogen" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.hydrogen", "match": "\\b(if|else|while|for|in|return|break|continue|match)\\b" },
        { "name": "keyword.other.import.hydrogen", "match": "\\b(use|include|as)\\b" },
        { "name": "storage.type.hydrogen", "match": "\\b(let|var|new|function|operator|type|class|enum|interface)\\b" },
        { "name": "storage.modifier.hydrogen", "match": "\\b(pub|own|mut|extern|any)\\b" },
        { "name": "keyword.operator.memory.hydrogen", "match": "\\b(alloc|free|asm)\\b" },
        { "name": "variable.language.self.hydrogen", "match": "\\bself\\b" },
        { "name": "constant.language.hydrogen", "match": "\\b(true|false|null)\\b" }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.hydrogen",
          "match": "\\b(int|uint|float|bool|char|str|string|i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|ptr|Self)\\b"
        },
        { "name": "entity.name.type.hydrogen", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.hydrogen", "match": "\\b0x[0-9A-Fa-f_]+\\b" },
        { "name": "constant.numeric.binary.hydrogen", "match": "\\b0b[01_]+\\b" },
        { "name": "constant.numeric.octal.hydrogen", "match": "\\b0o[0-7_]+\\b" },
        { "name": "constant.numeric.float.hydrogen", "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" },
        { "name": "constant.numeric.integer.hydrogen", "match": "\\b[0-9][0-9_]*([eE][+-]?[0-9]+)?\\b" }
      ]
    },
    "calls": {
      "patterns": [
        { "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()", "captures": { "1": { "name": "entity.name.function.call.hydrogen" } } }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.arrow.hydrogen", "match": "->|=>" },
        { "name": "keyword.operator.range.hydrogen", "match": "\\.\\." },
        { "name": "keyword.operator.try.hydrogen", "match": "\\?" },
        { "name": "keyword.operator.hydrogen", "match": "==|!=|<=|>=|&&|\\|\\||<<|>>|[-+*/%&|^~!<>=]" }
      ]
    }
  }
}
