// The math of a forward pass, on raw f32 buffers.
//
// Dot products use SIMD: four 8-lane accumulators (32 floats in flight), so the
// CPU never waits on one long chain of additions. Summing in that order rounds
// slightly differently from a plain loop (about 1e-6 relative); the generated
// text still matches the numpy reference in the tests.

// A row-major matrix view into memory someone else owns (usually the mapped model file).
pub new type Matrix {
    data: ptr<f32>
    rows: int
    cols: int
}

// 8 floats starting at p[i] (any alignment)
new function load8(p: ptr<f32>, i: int) -> f32x8 { return ptr<f32x8>(&p[i])[0] }

// sum over i of a[i] * b[i]
pub new function dot(a: ptr<f32>, b: ptr<f32>, n: int) -> f32 {
    var s0 = f32x8(0.0)
    var s1 = f32x8(0.0)
    var s2 = f32x8(0.0)
    var s3 = f32x8(0.0)
    var j = 0
    while j + 32 <= n {
        s0 = s0 + load8(a, j) * load8(b, j)
        s1 = s1 + load8(a, j + 8) * load8(b, j + 8)
        s2 = s2 + load8(a, j + 16) * load8(b, j + 16)
        s3 = s3 + load8(a, j + 24) * load8(b, j + 24)
        j += 32
    }
    while j + 8 <= n {
        s0 = s0 + load8(a, j) * load8(b, j)
        j += 8
    }
    var sum = f32x8_sum((s0 + s1) + (s2 + s3))
    while j < n {
        sum += a[j] * b[j]
        j += 1
    }
    return sum
}

// y += a * x
pub new function axpy(y: ptr<f32>, a: f32, x: ptr<f32>, n: int) {
    let av = f32x8(a)
    var j = 0
    while j + 8 <= n {
        ptr<f32x8>(&y[j])[0] = load8(y, j) + av * load8(x, j)
        j += 8
    }
    while j < n {
        y[j] += a * x[j]
        j += 1
    }
}

// out[i] = sum over j of m[i][j] * x[j]       (out: m.rows values, x: m.cols values)
pub new function matvec(out: ptr<f32>, m: Matrix, x: ptr<f32>) {
    matvec_rows(out, m, x, 0, m.rows)
}

// matvec split across a pool's threads, each taking a block of rows. Small
// matrices stay on one thread: below ~64K multiply-adds, waking the others costs more than it saves.
pub new function matvec_pool(pool: Pool, out: ptr<f32>, m: Matrix, x: ptr<f32>) {
    if m.rows * m.cols < 65536 || pool.size() == 1 {
        matvec_rows(out, m, x, 0, m.rows)
        return
    }
    var job = MatvecJob(out, m, x)
    pool.run(m.rows, ptr<u8>(&job), matvec_part)
}

new type MatvecJob {
    out: ptr<f32>
    m: Matrix
    x: ptr<f32>
}

// Each thread reads the shared weights and input and writes only its own rows of `out`.
new function matvec_part(context: ptr<u8>, first: int, last: int) {
    let job = ptr<MatvecJob>(context)
    matvec_rows(job.out, job.m, job.x, first, last)
}

// matvec for rows [first, last) only: threads split a matrix this way.
pub new function matvec_rows(out: ptr<f32>, m: Matrix, x: ptr<f32>, first: int, last: int) {
    let n = m.cols
    for i in first..last { out[i] = dot(ptr<f32>(&m.data[i * n]), x, n) }
}

// out = weight * x / rms(x)
pub new function rmsnorm(out: ptr<f32>, x: ptr<f32>, weight: ptr<f32>, size: int, eps: f32) {
    var ss: f32 = 0.0
    for j in 0..size { ss += x[j] * x[j] }
    ss /= f32(size)
    ss += eps
    ss = 1.0 / sqrtf(ss)
    for j in 0..size { out[j] = weight[j] * (ss * x[j]) }
}

// In place: x becomes a probability distribution.
pub new function softmax(x: ptr<f32>, size: int) {
    var max_val = x[0]
    for i in 1..size { if x[i] > max_val { max_val = x[i] } }
    var sum: f32 = 0.0
    for i in 0..size {
        x[i] = expf(x[i] - max_val)
        sum += x[i]
    }
    for i in 0..size { x[i] /= sum }
}

// a += b
pub new function add_into(a: ptr<f32>, b: ptr<f32>, size: int) {
    for i in 0..size { a[i] += b[i] }
}

// The softmax probability of x[best] (x: logits), without changing x.
pub new function top_probability(x: ptr<f32>, size: int, best: int) -> f32 {
    let top = x[best]
    var sum: f32 = 0.0
    for i in 0..size { sum += expf(x[i] - top) }
    return 1.0 / sum
}

pub new function argmax(x: ptr<f32>, size: int) -> int {
    var best = 0
    for i in 1..size { if x[i] > x[best] { best = i } }
    return best
}

// &p[i], as a pointer
pub new function offset(p: ptr<f32>, i: int) -> ptr<f32> { return ptr<f32>(&p[i]) }
