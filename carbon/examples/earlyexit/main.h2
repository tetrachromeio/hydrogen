// Would early exit pay off for this model? Generates greedily (the model's own
// text, unchanged) while probing every layer: after each one, the token the
// model would predict if it stopped there, and how sure it is. Then reports:
//
//   1. per layer: how often that early prediction already equals the final one
//   2. calibration: at each confidence threshold, how often a confident early
//      prediction is right
//   3. a simulated policy: exit at the first layer (from -m on) whose confidence
//      reaches the threshold; how many tokens exit, how many come out wrong, and
//      the speed-up after paying for every probe (an output-layer multiply each)
//
//   build/earlyexit <model.gguf> [-n tokens per prompt] [-m first layer that may exit] [-T threads]
use Elemental
use Elemental.Thread
use Carbon

const THRESHOLDS = 6

new function threshold(i: int) -> f32 {
    if i == 0 { return 0.5 }
    if i == 1 { return 0.7 }
    if i == 2 { return 0.8 }
    if i == 3 { return 0.9 }
    if i == 4 { return 0.95 }
    return 0.99
}

new function pct(part: int, whole: int) -> string {
    if whole == 0 { return string("   -  ") }
    return pad_left(fixed(100.0 * f64(part) / f64(whole), 1), 5) + "%"
}

new function main() -> int {
    let argv = args()
    if argv.len() < 2 {
        eprint("usage: earlyexit <model.gguf> [-n tokens per prompt] [-m first exit layer] [-T threads]")
        return 2
    }
    var per_prompt = 80
    var min_layer = -1
    var threads = cpu_count()
    var i: uint = 2
    while i + 1 < argv.len() {
        let flag: str = argv[i]
        let value: str = argv[i + 1]
        if flag == "-n" { per_prompt = unwrap_or(parse_int(value), 80) }
        else if flag == "-m" { min_layer = unwrap_or(parse_int(value), -1) }
        else if flag == "-T" { threads = unwrap_or(parse_int(value), threads) }
        i += 2
    }

    match load_model(argv[1]) {
        Err(e) => {
            eprint("error: " + e)
            return 1
        }
        Ok(model) => {
            match model_tokenizer(model) {
                Err(e) => {
                    eprint("error: " + e)
                    return 1
                }
                Ok(tok) => { return study(model, tok, per_prompt, min_layer, threads) }
            }
        }
    }
    return 0
}

new function study(model: Model, tok: Tokenizer, per_prompt: int, min_arg: int, threads: int) -> int {
    let c = model.config
    let L = c.n_layers
    var min_layer = min_arg
    if min_layer < 0 { min_layer = L / 3 }

    var prompts = List<string>()
    prompts.push(string("Write a haiku about the ocean."))
    prompts.push(string("Explain how a refrigerator works, in simple terms."))
    prompts.push(string("List five fruits and their colors."))
    prompts.push(string("Write a short story about a robot who learns to paint."))
    prompts.push(string("What are the benefits of regular exercise?"))
    prompts.push(string("Translate 'good morning' into French, Spanish and German."))

    // Per token: each layer's early prediction and confidence, and the final token.
    var early = List<int>()
    var conf = List<f32>()
    var finals = List<int>()

    for prompt in prompts {
        var state = State(c, threads)
        state.probe = true
        let tokens = prompt_tokens(model, tok, prompt, true)
        var token = tokens[0]
        var pos = 0
        var made = 0
        while pos < c.seq_len && made < per_prompt {
            let logits = model.forward(state, token, pos)
            var next = 0
            if pos < int(tokens.len()) - 1 {
                next = tokens[uint(pos + 1)]
            } else {
                next = argmax(logits, c.vocab_size)
                if next == model.bos || next == model.eos { break }
                for l in 0..L {
                    early.push(int(state.probe_token[l]))
                    conf.push(state.probe_confidence[l])
                }
                finals.push(next)
                made += 1
            }
            pos += 1
            token = next
        }
        eprint("  {prompt} ({made} tokens)")
    }

    let n = int(finals.len())
    print("\n{n} generated tokens, {L} layers. Early prediction = this layer's hidden state")
    print("through the final norm and output layer; agrees = same token as the full model.\n")

    print("layer  agrees   conf>=0.9  of those right")
    for l in 0..L {
        var agree = 0
        var confident = 0
        var confident_right = 0
        for t in 0..n {
            let right = early[uint(t * L + l)] == finals[uint(t)]
            if right { agree += 1 }
            if conf[uint(t * L + l)] >= 0.9 {
                confident += 1
                if right { confident_right += 1 }
            }
        }
        print("{pad_left(string(l + 1), 5)}  {pct(agree, n)}   {pct(confident, n)}   {pct(confident_right, confident)}")
    }

    // Cost in multiply-adds (weights read): a layer, and one output-layer multiply (a probe).
    let kv_dim = c.dim * c.n_kv_heads / c.n_heads
    let layer_cost = f64(2 * c.dim * c.dim + 2 * c.dim * kv_dim + 3 * c.dim * c.hidden_dim)
    let probe_cost = f64(c.vocab_size * c.dim)
    let full = f64(L) * layer_cost + probe_cost

    print("\nPolicy: probe after each layer from {min_layer + 1} on; exit at the first with confidence >= threshold.")
    print("(Exited tokens skip the rest; their skipped layers' key/value entries are not counted.)\n")
    print("threshold  exit  wrong  avg layers  speed-up")
    for k in 0..THRESHOLDS {
        let thr = threshold(k)
        var exits = 0
        var wrong = 0
        var layers_total = 0
        var cost = 0.0
        for t in 0..n {
            var exit_at = -1
            for l in min_layer..L - 1 {
                if exit_at < 0 && conf[uint(t * L + l)] >= thr { exit_at = l }
            }
            if exit_at >= 0 {
                exits += 1
                if early[uint(t * L + exit_at)] != finals[uint(t)] { wrong += 1 }
                layers_total += exit_at + 1
                cost += f64(exit_at + 1) * layer_cost + f64(exit_at - min_layer + 1) * probe_cost
            } else {
                layers_total += L
                cost += f64(L) * layer_cost + f64(L - 1 - min_layer) * probe_cost + probe_cost
            }
        }
        let avg = f64(layers_total) / f64(n)
        let speedup = full * f64(n) / cost
        print("{pad_left(fixed(f64(thr), 2), 9)}  {pct(exits, n)} {pct(wrong, n)}  {pad_left(fixed(avg, 1), 10)}  {pad_left(fixed(speedup, 2), 7)}x")
    }
    return 0
}
