// Q8_0 quantization: numbers stored as int8 in groups (usually 32 or 64), each
// group with one f32 scale: value = q * scale. A quarter of f32's size, and the
// dot products run on integers. Same scheme and file layout as llama2.c's runq.c.

// How a weight matrix is stored.
pub const FORMAT_F32 = 0       // plain f32
pub const FORMAT_Q8 = 1        // llama2.c Q8_0: all int8 values, then all f32 scales
pub const FORMAT_Q8_BLOCKS = 2 // GGUF Q8_0: blocks of (f16 scale, 32 x int8), 34 bytes each
pub const FORMAT_Q4_0 = 3      // GGUF Q4_0: blocks of (f16 scale, 32 x 4 bits), 18 bytes each
pub const FORMAT_Q6_K = 4      // GGUF Q6_K: 256 values in 210 bytes (6-bit values, a scale per 16, an f16 per block)

// A weight matrix (rows x cols). Views into the model file.
pub new type Weights {
    f: ptr<f32>    // FORMAT_F32: the values
    q: ptr<i8>     // FORMAT_Q8: rows * cols int8 values; FORMAT_Q8_BLOCKS: the first block
    s: ptr<f32>    // FORMAT_Q8: one scale per `group` values
    rows: int
    cols: int
    group: int     // values per scale (0 for f32)
    format: int
}

// An activation vector quantized on the fly (scratch space in State).
new type QVec {
    q: ptr<i8>
    s: ptr<f32>
}

pub new function is_quantized(w: Weights) -> bool { return w.format != FORMAT_F32 }

// x rounded half away from zero, like C's roundf
new function round_away(x: f32) -> f32 {
    let r = floor(abs(f64(x)) + 0.5)
    if x < 0.0 { return f32(-r) }
    return f32(r)
}

// Quantizes n values (n a multiple of group): each group's largest magnitude maps to 127.
pub new function quantize(q: ptr<i8>, s: ptr<f32>, x: ptr<f32>, n: int, group: int) {
    for g in 0..n / group {
        let base = g * group
        var wmax: f32 = 0.0
        for i in 0..group {
            var v = x[base + i]
            if v < 0.0 { v = -v }
            if v > wmax { wmax = v }
        }
        let scale = wmax / 127.0
        s[g] = scale
        for i in 0..group {
            if scale == 0.0 { q[base + i] = 0 }
            else { q[base + i] = i8(round_away(x[base + i] / scale)) }
        }
    }
}

// Row `r` of the weights, as f32 (for the token embedding).
pub new function weights_row(out: ptr<f32>, w: Weights, r: int) {
    let n = w.cols
    if !is_quantized(w) {
        for j in 0..n { out[j] = w.f[r * n + j] }
        return
    }
    if w.format == FORMAT_Q4_0 {
        let row = ptr<u8>(&ptr<u8>(w.q)[r * (n / 32) * 18])
        for b in 0..n / 32 {
            let block = ptr<u8>(&row[b * 18])
            let d = f32(ptr<f16>(block)[0])
            for j in 0..16 {
                let byte = int(block[2 + j])
                out[b * 32 + j] = f32((byte & 15) - 8) * d
                out[b * 32 + 16 + j] = f32((byte >> 4) - 8) * d
            }
        }
        return
    }
    if w.format == FORMAT_Q6_K {
        let row = ptr<u8>(&ptr<u8>(w.q)[r * (n / 256) * 210])
        for b in 0..n / 256 {
            let block = ptr<u8>(&row[b * 210])
            let d = f32(ptr<f16>(&block[208])[0])
            let sc = ptr<i8>(&block[192])
            for c in 0..2 {
                let ql = ptr<u8>(&block[c * 64])
                let qh = ptr<u8>(&block[128 + c * 32])
                let y = b * 256 + c * 128
                for l in 0..32 {
                    let is = c * 8 + l / 16
                    let h = int(qh[l])
                    out[y + l] = d * f32(sc[is]) * f32(((int(ql[l]) & 15) | ((h & 3) << 4)) - 32)
                    out[y + l + 32] = d * f32(sc[is + 2]) * f32(((int(ql[l + 32]) & 15) | (((h >> 2) & 3) << 4)) - 32)
                    out[y + l + 64] = d * f32(sc[is + 4]) * f32(((int(ql[l]) >> 4) | (((h >> 4) & 3) << 4)) - 32)
                    out[y + l + 96] = d * f32(sc[is + 6]) * f32(((int(ql[l + 32]) >> 4) | (((h >> 6) & 3) << 4)) - 32)
                }
            }
        }
        return
    }
    if w.format == FORMAT_Q8_BLOCKS {
        let row = ptr<u8>(&ptr<u8>(w.q)[r * (n / 32) * 34])
        for b in 0..n / 32 {
            let block = ptr<u8>(&row[b * 34])
            let d = f32(ptr<f16>(block)[0])
            let qs = ptr<i8>(&block[2])
            for j in 0..32 { out[b * 32 + j] = f32(qs[j]) * d }
        }
        return
    }
    let base = r * n
    for j in 0..n { out[j] = f32(w.q[base + j]) * w.s[(base + j) / w.group] }
}

// One output row of a GGUF Q8_0 matrix times a quantized vector (group 32).
new function qdot_row_blocks(w: Weights, x: QVec, row: int) -> f32 {
    let nb = w.cols / 32
    let base = ptr<u8>(&ptr<u8>(w.q)[row * nb * 34])
    var accf = f32x16(0.0)
    for b in 0..nb {
        let block = ptr<u8>(&base[b * 34])
        let qs = ptr<i8>(&block[2])
        let acc = load16(qs, 0) * load16(x.q, b * 32) + load16(qs, 16) * load16(x.q, b * 32 + 16)
        accf = accf + f32x16(acc) * f32x16(f32(ptr<f16>(block)[0]) * x.s[b])
    }
    return f32x16_sum(accf)
}

// 16 int8 at p[i], widened to i32
new function load16(p: ptr<i8>, i: int) -> i32x16 { return i32x16(ptr<i8x16>(&p[i])[0]) }

// One output of a Q8_0 matrix-vector product. Within a group, an exact integer
// dot product (16 lanes at a time); each group's lane sums are then scaled by
// both groups' scales into a float accumulator, reduced once at the end.
new function qdot_row(w: Weights, x: QVec, row: int) -> f32 {
    let n = w.cols
    let gs = w.group
    let wq = ptr<i8>(&w.q[row * n])
    let ws = ptr<f32>(&w.s[row * n / gs])
    if gs % 16 == 0 {
        var accf = f32x16(0.0)
        var g = 0
        while g < n / gs {
            let base = g * gs
            var acc = load16(wq, base) * load16(x.q, base)
            var j = 16
            while j < gs {
                acc = acc + load16(wq, base + j) * load16(x.q, base + j)
                j += 16
            }
            accf = accf + f32x16(acc) * f32x16(ws[g] * x.s[g])
            g += 1
        }
        return f32x16_sum(accf)
    }
    var val: f32 = 0.0
    for g in 0..n / gs {
        let base = g * gs
        var ival: i32 = 0
        for j in 0..gs { ival = ival + i32(wq[base + j]) * i32(x.q[base + j]) }
        val += f32(ival) * ws[g] * x.s[g]
    }
    return val
}

// GGUF Q4_0: each byte holds two values (low nibble: the block's first 16, high: its last 16), stored + 8.
new function qdot_row_q4(w: Weights, x: QVec, row: int) -> f32 {
    let nb = w.cols / 32
    let base = ptr<u8>(&ptr<u8>(w.q)[row * nb * 18])
    let low = u8x16(15)
    let four = u8x16(4)
    let eight = i8x16(8)
    var accf = f32x16(0.0)
    for b in 0..nb {
        let block = ptr<u8>(&base[b * 18])
        let qs = ptr<u8x16>(&block[2])[0]
        let lo = i8x16(qs & low) - eight
        let hi = i8x16(qs >> four) - eight
        let acc = i32x16(lo) * load16(x.q, b * 32) + i32x16(hi) * load16(x.q, b * 32 + 16)
        accf = accf + f32x16(acc) * f32x16(f32(ptr<f16>(block)[0]) * x.s[b])
    }
    return f32x16_sum(accf)
}

// GGUF Q6_K, ggml's layout: per 256-value block, ql (128 bytes: low 4 bits),
// qh (64 bytes: high 2 bits), 16 int8 scales (one per 16 values), f16 d.
// Each half-block of 128 values decodes as four runs of 32 from the same bytes.
new function qdot_row_q6k(w: Weights, x: QVec, row: int) -> f32 {
    let nb = w.cols / 256
    let base = ptr<u8>(&ptr<u8>(w.q)[row * nb * 210])
    let low = u8x16(15)
    let three = u8x16(3)
    let two = u8x16(2)
    let four = u8x16(4)
    let six = u8x16(6)
    let bias = i8x16(32)
    var accf = f32x16(0.0)
    for b in 0..nb {
        let block = ptr<u8>(&base[b * 210])
        let d = f32(ptr<f16>(&block[208])[0])
        let sc = ptr<i8>(&block[192])
        for c in 0..2 {
            let ql = ptr<u8>(&block[c * 64])
            let qh = ptr<u8>(&block[128 + c * 32])
            let y = b * 256 + c * 128
            var a0 = i32x16(i32(0))
            var a1 = i32x16(i32(0))
            var a2 = i32x16(i32(0))
            var a3 = i32x16(i32(0))
            for h in 0..2 {
                let l0 = ptr<u8x16>(&ql[h * 16])[0]
                let l1 = ptr<u8x16>(&ql[32 + h * 16])[0]
                let hh = ptr<u8x16>(&qh[h * 16])[0]
                let q1 = i8x16((l0 & low) | ((hh & three) << four)) - bias
                let q2 = i8x16((l1 & low) | (((hh >> two) & three) << four)) - bias
                let q3 = i8x16((l0 >> four) | (((hh >> four) & three) << four)) - bias
                let q4 = i8x16((l1 >> four) | (((hh >> six) & three) << four)) - bias
                let is = c * 8 + h
                a0 = a0 + i32x16(q1) * load16(x.q, y + h * 16) * i32x16(i32(sc[is]))
                a1 = a1 + i32x16(q2) * load16(x.q, y + 32 + h * 16) * i32x16(i32(sc[is + 2]))
                a2 = a2 + i32x16(q3) * load16(x.q, y + 64 + h * 16) * i32x16(i32(sc[is + 4]))
                a3 = a3 + i32x16(q4) * load16(x.q, y + 96 + h * 16) * i32x16(i32(sc[is + 6]))
            }
            let g = y / 32
            accf = accf + f32x16(a0) * f32x16(d * x.s[g]) + f32x16(a1) * f32x16(d * x.s[g + 1])
            accf = accf + f32x16(a2) * f32x16(d * x.s[g + 2]) + f32x16(a3) * f32x16(d * x.s[g + 3])
        }
    }
    return f32x16_sum(accf)
}

new function qmatvec_rows(out: ptr<f32>, w: Weights, x: QVec, first: int, last: int) {
    if w.format == FORMAT_Q4_0 {
        for i in first..last { out[i] = qdot_row_q4(w, x, i) }
        return
    }
    if w.format == FORMAT_Q6_K {
        for i in first..last { out[i] = qdot_row_q6k(w, x, i) }
        return
    }
    if w.format == FORMAT_Q8_BLOCKS {
        for i in first..last { out[i] = qdot_row_blocks(w, x, i) }
        return
    }
    for i in first..last { out[i] = qdot_row(w, x, i) }
}

new type QJob {
    out: ptr<f32>
    w: Weights
    x: QVec
}

new function qmatvec_part(context: ptr<u8>, first: int, last: int) {
    let job = ptr<QJob>(context)
    qmatvec_rows(job.out, job.w, job.x, first, last)
}

// out = w * x, for either kind of weights. Quantized weights first quantize x
// into the scratch `xq` (with the same group size).
pub new function matmul(pool: Pool, out: ptr<f32>, w: Weights, x: ptr<f32>, xq: QVec) {
    if !is_quantized(w) {
        matvec_pool(pool, out, Matrix(w.f, w.rows, w.cols), x)
        return
    }
    quantize(xq.q, xq.s, x, w.cols, w.group)
    if w.rows * w.cols < 65536 || pool.size() == 1 {
        qmatvec_rows(out, w, xq, 0, w.rows)
        return
    }
    var job = QJob(out, w, xq)
    pool.run(w.rows, ptr<u8>(&job), qmatvec_part)
}
