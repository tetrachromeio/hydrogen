use Elemental

new type Meters : f64

new class Point {
    x: Meters
    y: Meters

    new function length() -> Meters {
        return sqrt(self.x * self.x + self.y * self.y)
    }
}

new function main() -> i32 {
    let p = Point(3.0, 4.0)
    print("Hello, Hydrogen")
    print(p.length())
    return 0
}
