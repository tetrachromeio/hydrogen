use Elemental

new type Vec2 {
    x: f32
    y: f32

    new function length(self) -> f32 {
        return Elemental.Math.sqrt(self.x * self.x + self.y * self.y)
    }
}

new function main() -> i32 {
    let v = Vec2 { x: 3.0, y: 4.0 }
    Elemental.IO.print("Hello, Hydrogen")
    Elemental.IO.print(v.length())
    return 0
}
