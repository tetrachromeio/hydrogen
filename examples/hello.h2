use Elemental

// A distinct type: Meters has float's representation, but doesn't mix with
// plain floats unless you convert explicitly.
new type Meters : float {
    new operator + (a: Meters, b: Meters) -> Meters { return Meters(float(a) + float(b)) }
    new operator * (a: Meters, b: Meters) -> Meters { return Meters(float(a) * float(b)) }
    new operator < (a: Meters, b: Meters) -> bool { return float(a) < float(b) }
    new operator string (m: Meters) -> string { return string(float(m)) + " m" }
}

new class Point {
    x: Meters
    y: Meters

    new function length() -> Meters {
        return Meters(sqrt(float(self.x * self.x + self.y * self.y)))
    }
}

new function main() -> int {
    let p = Point(3.0, 4.0)          // stack: cleaned up at end of scope
    let q = alloc Point(6.0, 8.0)    // heap: q is a ptr<Point>
    print("Hello, Hydrogen")
    print(p.length())                // "5.0 m": Meters knows how to print itself
    if p.length() < q.length() {
        print("p is closer to the origin")
    }
    free q
    return 0
}
