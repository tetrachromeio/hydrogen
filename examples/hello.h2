use Elemental

new type Meters : f64 {
    new operator + (a: Meters, b: Meters) -> Meters { return Meters(f64(a) + f64(b)) }
    new operator * (a: Meters, b: Meters) -> Meters { return Meters(f64(a) * f64(b)) }
}

new class Point {
    x: Meters
    y: Meters

    new function length() -> Meters {
        return sqrt(self.x * self.x + self.y * self.y)
    }
}

new function main() -> int {
    let p = Point(3.0, 4.0)          // stack
    let q = alloc Point(6.0, 8.0)    // heap
    print("Hello, Hydrogen")
    print(p.length())
    print(q.length())
    free q
    return 0
}
