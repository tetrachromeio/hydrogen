// SIMD vectors: several numbers processed by one instruction (SSE/AVX on x86-64,
// NEON on ARM64). Freestanding: they compile to plain CPU instructions.
//
//     let a = ptr<f32x8>(&xs[i])[0]       // load 8 floats from memory (any alignment)
//     ptr<f32x8>(&out[i])[0] = a * b      // store 8
//     var acc = f32x8(0.0)                // every lane set to one value
//     acc = f32x8_fma(a, b, acc)          // a * b + acc, lane by lane
//     let total = f32x8_sum(acc)          // all lanes added together
//     let first = a[0]                    // one lane
//     let wide = i32x16(bytes)            // lane-by-lane conversion (same lane count)
//
// Integer vector arithmetic wraps around (no overflow checks), as SIMD hardware does.
// Shifts take a vector of amounts (u8x16(4): every lane by 4); >> is logical for
// unsigned lanes and arithmetic for signed ones.


pub new type f32x4 : vector(f32, 4) {
    new operator + (a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fadd(a, b) }
    new operator - (a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fsub(a, b) }
    new operator * (a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fmul(a, b) }
    new operator / (a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fdiv(a, b) }
    new operator - (a: f32x4) -> f32x4 { return intrinsic.fneg(a) }
    new operator [] (v: f32x4, i: int) -> f32 { return intrinsic.lane(v, i) }
}
pub new function f32x4_sum(v: f32x4) -> f32 { return intrinsic.vsum(v) }
pub new function f32x4_with(v: f32x4, i: int, x: f32) -> f32x4 { return intrinsic.with_lane(v, i, x) }
pub new function f32x4_fma(a: f32x4, b: f32x4, c: f32x4) -> f32x4 { return intrinsic.fma(a, b, c) }
pub new function f32x4_max(a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fmax(a, b) }
pub new function f32x4_min(a: f32x4, b: f32x4) -> f32x4 { return intrinsic.fmin(a, b) }

