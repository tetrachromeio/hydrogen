pub new function u8x16_with(v: u8x16, i: int, x: u8) -> u8x16 { return intrinsic.with_lane(v, i, x) }
pub new function u8x16_max(a: u8x16, b: u8x16) -> u8x16 { return intrinsic.umax(a, b) }
pub new function u8x16_min(a: u8x16, b: u8x16) -> u8x16 { return intrinsic.umin(a, b) }

pub new type u8x32 : vector(u8, 32) {
    new operator + (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.wadd(a, b) }
    new operator - (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.wsub(a, b) }
    new operator * (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.wmul(a, b) }
    new operator & (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.and(a, b) }
    new operator | (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.or(a, b) }
    new operator ^ (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.xor(a, b) }
    new operator << (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.shl(a, b) }
    new operator >> (a: u8x32, b: u8x32) -> u8x32 { return intrinsic.lshr(a, b) }
    new operator [] (v: u8x32, i: int) -> u8 { return intrinsic.lane(v, i) }
}
pub new function u8x32_sum(v: u8x32) -> u8 { return intrinsic.vsum(v) }
pub new function u8x32_with(v: u8x32, i: int, x: u8) -> u8x32 { return intrinsic.with_lane(v, i, x) }
pub new function u8x32_max(a: u8x32, b: u8x32) -> u8x32 { return intrinsic.umax(a, b) }
pub new function u8x32_min(a: u8x32, b: u8x32) -> u8x32 { return intrinsic.umin(a, b) }

