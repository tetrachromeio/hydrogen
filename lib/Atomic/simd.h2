    new operator * (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.wmul(a, b) }
    new operator & (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.and(a, b) }
    new operator | (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.or(a, b) }
    new operator ^ (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.xor(a, b) }
    new operator << (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.shl(a, b) }
    new operator >> (a: u8x64, b: u8x64) -> u8x64 { return intrinsic.lshr(a, b) }
    new operator [] (v: u8x64, i: int) -> u8 { return intrinsic.lane(v, i) }
}
pub new function u8x64_sum(v: u8x64) -> u8 { return intrinsic.vsum(v) }
pub new function u8x64_with(v: u8x64, i: int, x: u8) -> u8x64 { return intrinsic.with_lane(v, i, x) }
pub new function u8x64_max(a: u8x64, b: u8x64) -> u8x64 { return intrinsic.umax(a, b) }
pub new function u8x64_min(a: u8x64, b: u8x64) -> u8x64 { return intrinsic.umin(a, b) }

pub new type u32x8 : vector(u32, 8) {
    new operator + (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.wadd(a, b) }
    new operator - (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.wsub(a, b) }
    new operator * (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.wmul(a, b) }
    new operator & (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.and(a, b) }
    new operator | (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.or(a, b) }
    new operator ^ (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.xor(a, b) }
    new operator << (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.shl(a, b) }
    new operator >> (a: u32x8, b: u32x8) -> u32x8 { return intrinsic.lshr(a, b) }
    new operator [] (v: u32x8, i: int) -> u32 { return intrinsic.lane(v, i) }
}
pub new function u32x8_sum(v: u32x8) -> u32 { return intrinsic.vsum(v) }
pub new function u32x8_with(v: u32x8, i: int, x: u32) -> u32x8 { return intrinsic.with_lane(v, i, x) }
pub new function u32x8_max(a: u32x8, b: u32x8) -> u32x8 { return intrinsic.umax(a, b) }
pub new function u32x8_min(a: u32x8, b: u32x8) -> u32x8 { return intrinsic.umin(a, b) }

pub new type i64x4 : vector(i64, 4) {
    new operator + (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.wadd(a, b) }
    new operator - (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.wsub(a, b) }
    new operator * (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.wmul(a, b) }
    new operator & (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.and(a, b) }
    new operator | (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.or(a, b) }
    new operator ^ (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.xor(a, b) }
    new operator << (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.shl(a, b) }
    new operator >> (a: i64x4, b: i64x4) -> i64x4 { return intrinsic.ashr(a, b) }
    new operator [] (v: i64x4, i: int) -> i64 { return intrinsic.lane(v, i) }
}
pub new function i64x4_sum(v: i64x4) -> i64 { return intrinsic.vsum(v) }
pub new function i64x4_with(v: i64x4, i: int, x: i64) -> i64x4 { return intrinsic.with_lane(v, i, x) }
pub new function i64x4_max(a: i64x4, b: i64x4) -> i64x4 { return intrinsic.smax(a, b) }
pub new function i64x4_min(a: i64x4, b: i64x4) -> i64x4 { return intrinsic.smin(a, b) }

// Integer dot product, 4 at a time: lane i of the result is
//   acc[i] + a[4i]*b[4i] + a[4i+1]*b[4i+1] + a[4i+2]*b[4i+2] + a[4i+3]*b[4i+3]
// One SDOT instruction on Apple Silicon; a short exact sequence elsewhere. The
// building block of int8 (quantized) matrix multiplies.
pub new function i8x16_dot(acc: i32x4, a: i8x16, b: i8x16) -> i32x4 { return intrinsic.dot4(acc, a, b) }
// True when i8x16_dot is a single instruction on the CPU being compiled for (a
// constant, so `if has_fast_i8_dot() { ... } else { ... }` keeps only one branch).
pub new function has_fast_i8_dot() -> bool { return intrinsic.fast_dot4() }

// Scalar fused multiply-add: a * b + c with one rounding.
pub new function fma_f32(a: f32, b: f32, c: f32) -> f32 { return intrinsic.fma(a, b, c) }
pub new function fma_f64(a: f64, b: f64, c: f64) -> f64 { return intrinsic.fma(a, b, c) }
