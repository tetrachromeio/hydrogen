// Atomic: the freestanding core of Hydrogen.
// Primitive types are ordinary `new type` declarations built from raw bits.
// Their operators lower directly to compiler intrinsics.

new type bool : bits(1) {
    new operator == (a: bool, b: bool) -> bool { return intrinsic.eq(a, b) }
    new operator ! (a: bool) -> bool { return intrinsic.not(a) }
}

new type i8  : bits(8)  signed
new type i16 : bits(16) signed
new type i32 : bits(32) signed
new type i64 : bits(64) signed {
    new operator + (a: i64, b: i64) -> i64 { return intrinsic.add(a, b) }
    new operator - (a: i64, b: i64) -> i64 { return intrinsic.sub(a, b) }
    new operator * (a: i64, b: i64) -> i64 { return intrinsic.mul(a, b) }
    new operator / (a: i64, b: i64) -> i64 { return intrinsic.sdiv(a, b) }
    new operator % (a: i64, b: i64) -> i64 { return intrinsic.srem(a, b) }
    new operator - (a: i64) -> i64 { return intrinsic.neg(a) }
    new operator == (a: i64, b: i64) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: i64, b: i64) -> bool { return intrinsic.slt(a, b) }
    new operator << (a: i64, n: i64) -> i64 { return intrinsic.shl(a, n) }
    new operator >> (a: i64, n: i64) -> i64 { return intrinsic.ashr(a, n) }
}

new type u8  : bits(8)
new type u16 : bits(16)
new type u32 : bits(32)
new type u64 : bits(64)
new type usize : bits(64)

new type f32 : float(32)
new type f64 : float(64)

new type char : bits(32)

// Friendly aliases.
new type int   : i64
new type uint  : u64
new type float : f64
