// Atomic: the freestanding core of Hydrogen.
//
// Freestanding means it needs no operating system and no C library: nothing
// here allocates, does I/O, or calls out of the program. That makes it usable
// for kernels, firmware and embedded code. Everything that needs an OS
// (owned strings, printing, files, memory allocation) lives in Elemental.
//
// Every module implicitly does `use Atomic`, so everything pub here is
// available everywhere. Primitive types are ordinary `new type` declarations
// built from raw bits. Their operators lower directly to compiler intrinsics,
// and `intrinsic` is only usable inside Atomic.
//
// The friendly names are the real types; the sized names are aliases:
//   int = i64, uint = u64 = usize, float = f64

// ---------------------------------------------------------------- integers

pub new type int : bits(64) signed {
    new operator + (a: int, b: int) -> int { return intrinsic.add(a, b) }
    new operator - (a: int, b: int) -> int { return intrinsic.sub(a, b) }
    new operator * (a: int, b: int) -> int { return intrinsic.mul(a, b) }
    new operator / (a: int, b: int) -> int { return intrinsic.sdiv(a, b) }
    new operator % (a: int, b: int) -> int { return intrinsic.srem(a, b) }
    new operator - (a: int) -> int { return intrinsic.neg(a) }
    new operator == (a: int, b: int) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: int, b: int) -> bool { return intrinsic.slt(a, b) }
    new operator & (a: int, b: int) -> int { return intrinsic.and(a, b) }
    new operator | (a: int, b: int) -> int { return intrinsic.or(a, b) }
    new operator ^ (a: int, b: int) -> int { return intrinsic.xor(a, b) }
    new operator ~ (a: int) -> int { return intrinsic.not(a) }
    new operator << (a: int, n: int) -> int { return intrinsic.shl(a, n) }
    new operator >> (a: int, n: int) -> int { return intrinsic.ashr(a, n) }
}

