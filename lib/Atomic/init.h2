pub new type i64   = int
pub new type u64   = uint
pub new type usize = uint

// ---------------------------------------------------------------- floats

pub new type float : float(64) {
    new operator + (a: float, b: float) -> float { return intrinsic.fadd(a, b) }
    new operator - (a: float, b: float) -> float { return intrinsic.fsub(a, b) }
    new operator * (a: float, b: float) -> float { return intrinsic.fmul(a, b) }
    new operator / (a: float, b: float) -> float { return intrinsic.fdiv(a, b) }
    new operator - (a: float) -> float { return intrinsic.fneg(a) }
    new operator == (a: float, b: float) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: float, b: float) -> bool { return intrinsic.flt(a, b) }
}

pub new type f32 : float(32) {
    new operator + (a: f32, b: f32) -> f32 { return intrinsic.fadd(a, b) }
    new operator - (a: f32, b: f32) -> f32 { return intrinsic.fsub(a, b) }
    new operator * (a: f32, b: f32) -> f32 { return intrinsic.fmul(a, b) }
    new operator / (a: f32, b: f32) -> f32 { return intrinsic.fdiv(a, b) }
    new operator - (a: f32) -> f32 { return intrinsic.fneg(a) }
    new operator == (a: f32, b: f32) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: f32, b: f32) -> bool { return intrinsic.flt(a, b) }
}

pub new type f64 = float

// ---------------------------------------------------------------- others

pub new type bool : bits(1) {
    new operator == (a: bool, b: bool) -> bool { return intrinsic.eq(a, b) }
    new operator ! (a: bool) -> bool { return intrinsic.not(a) }
}

pub new type char : bits(32) {
    new operator == (a: char, b: char) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: char, b: char) -> bool { return intrinsic.ult(a, b) }
}

// ---------------------------------------------------------------- text

// str: a borrowed view of UTF-8 bytes (pointer + length). Owns nothing and
// never allocates. String literals are str. The owned, growable `string`
// lives in Elemental, because it needs an allocator.
pub new type str {
    pub data: ptr<u8>
    pub len:  uint

    new operator [] (s: str, i: uint) -> u8 { return s.data[i] }
    new operator == (a: str, b: str) -> bool {
        if a.len != b.len { return false }
        var i: uint = 0
        while i < a.len {
            if a.data[i] != b.data[i] { return false }
            i += 1
        }
        return true
    }
}

// ---------------------------------------------------------------- interfaces

pub new interface Equatable {
    new operator == (a: Self, b: Self) -> bool
}

pub new interface Ordered {
    new operator < (a: Self, b: Self) -> bool
}

// ---------------------------------------------------------------- errors

// Errors are values. `expr?` unwraps Ok, or returns the Err to the caller.
pub new enum Result<T, E> {
    Ok(T)
    Err(E)
}

pub new enum Option<T> {
    Some(T)
    None
}

// ---------------------------------------------------------------- wrapping arithmetic

// Arithmetic that wraps around on overflow, on purpose (hashes, checksums,
// random numbers). Normal + - * stop the program on overflow in debug builds.
pub new function wrapping_add(a: uint, b: uint) -> uint { return intrinsic.wadd(a, b) }
pub new function wrapping_sub(a: uint, b: uint) -> uint { return intrinsic.wsub(a, b) }
pub new function wrapping_mul(a: uint, b: uint) -> uint { return intrinsic.wmul(a, b) }

// ---------------------------------------------------------------- hashing

// A type is Hashable if it defines `operator hash`. Equal values must have
// equal hashes. Used by Elemental's Map.
pub new interface Hashable {
    new operator hash (v: Self) -> uint
}

// The hash of any Hashable value.
pub new function hash<T: Hashable>(value: T) -> uint { return intrinsic.op_hash(value) }

// Spreads the bits of a number (the splitmix64 finalizer).
new function mix(x: uint) -> uint {
    let k1: uint = 0xbf58476d1ce4e5b9
    let k2: uint = 0x94d049bb133111eb
    var z = wrapping_mul(x ^ (x >> 30), k1)
    z = wrapping_mul(z ^ (z >> 27), k2)
    return z ^ (z >> 31)
}

pub new operator hash (v: uint) -> uint { return mix(v) }
pub new operator hash (v: int) -> uint { return mix(uint(v)) }
pub new operator hash (v: u32) -> uint { return mix(uint(v)) }
pub new operator hash (v: u16) -> uint { return mix(uint(v)) }
pub new operator hash (v: u8) -> uint { return mix(uint(v)) }
pub new operator hash (v: i32) -> uint { return mix(uint(v)) }
pub new operator hash (v: i16) -> uint { return mix(uint(v)) }
pub new operator hash (v: i8) -> uint { return mix(uint(v)) }
pub new operator hash (v: char) -> uint { return mix(uint(v)) }
pub new operator hash (v: bool) -> uint { return mix(uint(v)) }

// FNV-1a over the bytes.
pub new operator hash (s: str) -> uint {
    let prime: uint = 1099511628211
    var h: uint = 14695981039346656037
    var i: uint = 0
    while i < s.len {
        h = wrapping_mul(h ^ uint(s.data[i]), prime)
        i += 1
    }
    return h
}

// ---------------------------------------------------------------- threads

// Values that may move to another thread. The compiler checks this itself:
// anything that doesn't point at memory the sender could still use (raw
// pointers, str views, any I, slices). Classes with `drop` own their memory,
// so string, List<T> and Map<K, V> qualify when their contents do.
pub new interface Sendable {}

// ---------------------------------------------------------------- Option helpers

// The value inside, or `fallback` if there is none.
pub new function unwrap_or<T>(option: own Option<T>, fallback: own T) -> T {
    match option {
        Some(value) => { return value }
        None => { return fallback }
    }
}

pub new function is_some<T>(option: Option<T>) -> bool {
    match option {
        Some(_) => { return true }
        None => { return false }
    }
}

pub new function is_none<T>(option: Option<T>) -> bool { return !is_some(option) }

// A marker: a type with a NotSendable field can't move to another thread
// (for example a lock guard, which must be released by the thread that took it).
pub new type NotSendable {}

// ---------------------------------------------------------------- atomics

// Lock-free operations on a shared int, visible to all threads at once
// (sequentially consistent). Elemental's AtomicInt wraps these.
pub new function atomic_load(p: ptr<int>) -> int { return intrinsic.atomic_load(p) }
pub new function atomic_store(p: ptr<int>, value: int) { intrinsic.atomic_store(p, value) }
// Adds and returns the value from before the add.
pub new function atomic_add(p: ptr<int>, value: int) -> int { return intrinsic.atomic_add(p, value) }
// Stores and returns the value from before.
pub new function atomic_swap(p: ptr<int>, value: int) -> int { return intrinsic.atomic_swap(p, value) }
// If the value is `expected`, replaces it with `desired` and returns true.
pub new function atomic_compare_swap(p: ptr<int>, expected: int, desired: int) -> bool {
    return intrinsic.atomic_cas(p, expected, desired)
}
