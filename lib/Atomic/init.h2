pub new type i64   = int
pub new type u64   = uint
pub new type usize = uint

// ---------------------------------------------------------------- floats

pub new type float : float(64) {
    new operator + (a: float, b: float) -> float { return intrinsic.fadd(a, b) }
    new operator - (a: float, b: float) -> float { return intrinsic.fsub(a, b) }
    new operator * (a: float, b: float) -> float { return intrinsic.fmul(a, b) }
    new operator / (a: float, b: float) -> float { return intrinsic.fdiv(a, b) }
    new operator - (a: float) -> float { return intrinsic.fneg(a) }
    new operator == (a: float, b: float) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: float, b: float) -> bool { return intrinsic.flt(a, b) }
}

pub new type f32 : float(32) {
    new operator + (a: f32, b: f32) -> f32 { return intrinsic.fadd(a, b) }
    new operator - (a: f32, b: f32) -> f32 { return intrinsic.fsub(a, b) }
    new operator * (a: f32, b: f32) -> f32 { return intrinsic.fmul(a, b) }
    new operator / (a: f32, b: f32) -> f32 { return intrinsic.fdiv(a, b) }
    new operator - (a: f32) -> f32 { return intrinsic.fneg(a) }
    new operator == (a: f32, b: f32) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: f32, b: f32) -> bool { return intrinsic.flt(a, b) }
}

pub new type f64 = float

// ---------------------------------------------------------------- others

pub new type bool : bits(1) {
    new operator == (a: bool, b: bool) -> bool { return intrinsic.eq(a, b) }
    new operator ! (a: bool) -> bool { return intrinsic.not(a) }
}

pub new type char : bits(32) {
    new operator == (a: char, b: char) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: char, b: char) -> bool { return intrinsic.ult(a, b) }
}

// A borrowed run of UTF-8 bytes. Does not own its memory.
pub new type string {
    pub data: ptr<u8>
    pub len:  uint

    new operator [] (s: string, i: uint) -> u8 { return s.data[i] }
    new operator == (a: string, b: string) -> bool { return intrinsic.memeq(a.data, b.data, a.len, b.len) }
}

// ---------------------------------------------------------------- errors

// Errors are values. `expr?` unwraps Ok, or returns the Err to the caller.
pub new enum Result<T, E> {
    Ok(T)
    Err(E)
}

pub new enum Option<T> {
    Some(T)
    None
}
