    new operator == (a: i32, b: i32) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: i32, b: i32) -> bool { return intrinsic.slt(a, b) }
    new operator & (a: i32, b: i32) -> i32 { return intrinsic.and(a, b) }
