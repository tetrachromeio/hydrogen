// ---------------------------------------------------------------- floats

pub new type float : float(64) {
    new operator + (a: float, b: float) -> float { return intrinsic.fadd(a, b) }
    new operator - (a: float, b: float) -> float { return intrinsic.fsub(a, b) }
    new operator * (a: float, b: float) -> float { return intrinsic.fmul(a, b) }
    new operator / (a: float, b: float) -> float { return intrinsic.fdiv(a, b) }
    new operator - (a: float) -> float { return intrinsic.fneg(a) }
    new operator == (a: float, b: float) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: float, b: float) -> bool { return intrinsic.flt(a, b) }
    new operator string (v: float) -> string { return intrinsic.float_to_string(v) }
}

pub new type f32 : float(32) {
    new operator + (a: f32, b: f32) -> f32 { return intrinsic.fadd(a, b) }
    new operator - (a: f32, b: f32) -> f32 { return intrinsic.fsub(a, b) }
    new operator * (a: f32, b: f32) -> f32 { return intrinsic.fmul(a, b) }
    new operator / (a: f32, b: f32) -> f32 { return intrinsic.fdiv(a, b) }
    new operator - (a: f32) -> f32 { return intrinsic.fneg(a) }
    new operator == (a: f32, b: f32) -> bool { return intrinsic.feq(a, b) }
    new operator < (a: f32, b: f32) -> bool { return intrinsic.flt(a, b) }
    new operator string (v: f32) -> string { return intrinsic.float_to_string(v) }
}

pub new type f64 = float

// ---------------------------------------------------------------- others

pub new type bool : bits(1) {
    new operator == (a: bool, b: bool) -> bool { return intrinsic.eq(a, b) }
    new operator ! (a: bool) -> bool { return intrinsic.not(a) }
    new operator string (b: bool) -> string {
        if b { return string("true") }
        return string("false")
    }
}

pub new type char : bits(32) {
    new operator == (a: char, b: char) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: char, b: char) -> bool { return intrinsic.ult(a, b) }
    new operator string (c: char) -> string { return intrinsic.char_to_string(c) }
}

// ---------------------------------------------------------------- text

// str: a borrowed view of UTF-8 bytes (pointer + length). Owns nothing.
// String literals are str. Cheap to pass around; never frees anything.
pub new type str {
    pub data: ptr<u8>
    pub len:  uint

    new operator [] (s: str, i: uint) -> u8 { return s.data[i] }
    new operator == (a: str, b: str) -> bool { return intrinsic.memeq(a.data, a.len, b.data, b.len) }
    new operator + (a: str, b: str) -> string {
        var out = string(a)
        out.append(b)
        return out
    }
    new operator + (a: str, b: string) -> string {
        var out = string(a)
        out.append(b.view())
        return out
    }
    new operator string (s: str) -> string { return string(s) }
}

// string: owned, growable UTF-8 text. Its memory is freed automatically
// when it goes out of scope (drop).
pub new class string {
    buf:  ptr<u8>
    used: uint
    cap:  uint

    // string("hello") copies the text.
    pub new function init(text: str) {
        self.buf = intrinsic.malloc(text.len)
        intrinsic.memcpy(self.buf, text.data, text.len)
        self.used = text.len
        self.cap = text.len
    }

    pub new function drop() { intrinsic.free(self.buf) }

    pub new function len() -> uint { return self.used }

    // A borrowed view of the text; valid while this string is alive and unchanged.
    pub new function view() -> str { return str(self.buf, self.used) }

    pub new function append(text: str) {
        let needed = self.used + text.len
        if needed > self.cap {
            var grown = self.cap * 2
            if grown < needed { grown = needed }
            self.buf = intrinsic.realloc(self.buf, grown)
            self.cap = grown
        }
        intrinsic.memcpy(&self.buf[self.used], text.data, text.len)
        self.used = needed
    }

    new operator [] (s: string, i: uint) -> u8 { return s.buf[i] }
    new operator == (a: string, b: string) -> bool { return a.view() == b.view() }
    new operator + (a: string, b: string) -> string {
        var out = string(a.view())
        out.append(b.view())
        return out
    }
    new operator + (a: string, b: str) -> string {
        var out = string(a.view())
        out.append(b)
        return out
    }
    new operator string (s: string) -> string { return string(s.view()) }
}

// Anything with `operator string` can be printed: print(x) calls string(x).
pub new interface Printable {
    new operator string (v: Self) -> string
}

// ---------------------------------------------------------------- errors

// Errors are values. `expr?` unwraps Ok, or returns the Err to the caller.
pub new enum Result<T, E> {
    Ok(T)
    Err(E)
}

pub new enum Option<T> {
    Some(T)
    None
}
