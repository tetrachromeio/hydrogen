pub new type uint : bits(64) {
    new operator + (a: uint, b: uint) -> uint { return intrinsic.add(a, b) }
    new operator - (a: uint, b: uint) -> uint { return intrinsic.sub(a, b) }
    new operator * (a: uint, b: uint) -> uint { return intrinsic.mul(a, b) }
    new operator / (a: uint, b: uint) -> uint { return intrinsic.udiv(a, b) }
    new operator % (a: uint, b: uint) -> uint { return intrinsic.urem(a, b) }
    new operator == (a: uint, b: uint) -> bool { return intrinsic.eq(a, b) }
    new operator < (a: uint, b: uint) -> bool { return intrinsic.ult(a, b) }
    new operator & (a: uint, b: uint) -> uint { return intrinsic.and(a, b) }
    new operator | (a: uint, b: uint) -> uint { return intrinsic.or(a, b) }
    new operator ^ (a: uint, b: uint) -> uint { return intrinsic.xor(a, b) }
    new operator ~ (a: uint) -> uint { return intrinsic.not(a) }
    new operator << (a: uint, n: uint) -> uint { return intrinsic.shl(a, n) }
    new operator >> (a: uint, n: uint) -> uint { return intrinsic.lshr(a, n) }
}

