// Map<K, V>: a hash map that remembers insertion order (like Python's dict).
//
// Entries live densely in `keys`/`vals`, in the order they were added. A
// separate index table (`slots`, open addressing with linear probing) maps a
// key's hash to its entry: -1 means empty, -2 means a removed entry.
// Removing an entry moves the last entry into its place.

pub new class Map<K: Hashable + Equatable, V> {
    keys:   ptr<K>
    vals:   ptr<V>
    count:  uint
    cap:    uint
    slots:  ptr<int>
    nslots: uint

    // Map<str, int>() is empty and allocates nothing until the first set.
    pub new function init() {}

    pub new function len() -> uint { return self.count }
    pub new function is_empty() -> bool { return self.count == 0 }

    // Sequence protocol: `for key in map` visits keys in insertion order.
    pub new function at(i: uint) -> ptr<K> { return &self.keys[i] }
    // The value of the i-th entry (same order as the keys).
    pub new function value_at(i: uint) -> ptr<V> { return &self.vals[i] }

    // The slot holding `key`, or the slot where it would go.
    new function find_slot(key: K) -> uint {
        let mask = self.nslots - 1
        var i = hash(key) & mask
        var free_slot = self.nslots
        while true {
            let s = self.slots[i]
            if s == -1 {
                if free_slot == self.nslots { return i }
                return free_slot
            }
            if s == -2 {
                if free_slot == self.nslots { free_slot = i }
            } else if self.keys[uint(s)] == key {
                return i
            }
            i = (i + 1) & mask
        }
    }

    new mut function grow_slots() {
        var n = self.nslots * 2
        if n < 8 { n = 8 }
        let fresh = ptr<int>(malloc(n * size_of(self.slots)))
        for i in 0..n { fresh[i] = -1 }
        free ptr<u8>(self.slots)
        self.slots = fresh
        self.nslots = n
        for e in 0..self.count {
            var i = hash(self.keys[e]) & (n - 1)
            while self.slots[i] != -1 { i = (i + 1) & (n - 1) }
            self.slots[i] = int(e)
        }
    }

    new mut function grow_entries() {
        var n = self.cap * 2
        if n < 4 { n = 4 }
        self.keys = ptr<K>(realloc(ptr<u8>(self.keys), n * size_of(self.keys)))
        self.vals = ptr<V>(realloc(ptr<u8>(self.vals), n * size_of(self.vals)))
        self.cap = n
    }

    // Adds or replaces the value for `key`. The map takes ownership of both.
    pub new mut function set(key: own K, value: own V) {
        if (self.count + 1) * 4 > self.nslots * 3 { self.grow_slots() }
        let i = self.find_slot(key)
        let s = self.slots[i]
        if s >= 0 {
            destroy(&self.vals[uint(s)])
            self.vals[uint(s)] = value
            return
        }
        if self.count == self.cap { self.grow_entries() }
        self.keys[self.count] = key
        self.vals[self.count] = value
        self.slots[i] = int(self.count)
        self.count += 1
    }

    // A pointer to the value for `key` (valid until the map changes), or None.
    pub new function get(key: K) -> Option<ptr<V>> {
        if self.count == 0 { return None }
        let s = self.slots[self.find_slot(key)]
        if s >= 0 { return Some(&self.vals[uint(s)]) }
        return None
    }

    pub new function has(key: K) -> bool {
        match self.get(key) {
            Some(p) => { return true }
            None => { return false }
        }
    }

    // Removes `key` and returns its value, or None if it wasn't there.
    pub new mut function remove(key: K) -> Option<V> {
        if self.count == 0 { return None }
        let i = self.find_slot(key)
        let s = self.slots[i]
        if s < 0 { return None }
        let e = uint(s)
        self.slots[i] = -2
        destroy(&self.keys[e])
        let out = take(&self.vals[e])
        let last = self.count - 1
        if e != last {
            self.keys[e] = take(&self.keys[last])
            self.vals[e] = take(&self.vals[last])
            var j = hash(self.keys[e]) & (self.nslots - 1)
            while self.slots[j] != int(last) { j = (j + 1) & (self.nslots - 1) }
            self.slots[j] = int(e)
        }
        self.count -= 1
        return Some(out)
    }

    pub new function drop() {
        for e in 0..self.count {
            destroy(&self.keys[e])
            destroy(&self.vals[e])
        }
        free ptr<u8>(self.keys)
        free ptr<u8>(self.vals)
        free ptr<u8>(self.slots)
    }
}
