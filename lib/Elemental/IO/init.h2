use Elemental

extern function write(fd: i32, data: ptr<u8>, len: uint) -> int

// print(x) works for anything Printable: every built-in type, and any type
// or class that defines `new operator string`.
pub new function print<T: Printable>(value: T) {
    let text = string(value)
    let v = text.view()
    write(1, v.data, v.len)
    write(1, "\n".data, 1)
}

pub new function eprint<T: Printable>(value: T) {
    let text = string(value)
    let v = text.view()
    write(2, v.data, v.len)
    write(2, "\n".data, 1)
}
