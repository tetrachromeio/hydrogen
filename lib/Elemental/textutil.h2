// Text tools. They work on str, and return views into the original text
// where they can (no allocation), so keep the original alive while you use them.

extern function h2_parse_float(text: ptr<u8>, len: uint, out: ptr<float>) -> bool

// The bytes from `start` up to (not including) `end`, clamped to the text.
pub new function slice(text: str, start: uint, end: uint) -> str {
    var e = end
    if e > text.len { e = text.len }
    var s = start
    if s > e { s = e }
    if s == e { return str(text.data, 0) }
    return str(&text.data[s], e - s)
}

pub new function starts_with(text: str, prefix: str) -> bool {
    if prefix.len > text.len { return false }
    return slice(text, 0, prefix.len) == prefix
}

pub new function ends_with(text: str, suffix: str) -> bool {
    if suffix.len > text.len { return false }
    return slice(text, text.len - suffix.len, text.len) == suffix
}

// Where `part` first appears, or None.
pub new function find(text: str, part: str) -> Option<uint> {
    if part.len > text.len { return None }
    var i: uint = 0
    while i + part.len <= text.len {
        if slice(text, i, i + part.len) == part { return Some(i) }
        i += 1
    }
    return None
}

pub new function contains(text: str, part: str) -> bool {
    match find(text, part) {
        Some(i) => { return true }
        None => { return false }
    }
}

new function is_space(b: u8) -> bool { return b == 32 || b == 9 || b == 10 || b == 13 }

// Without spaces, tabs and newlines at either end.
pub new function trim(text: str) -> str {
    var start: uint = 0
    var end = text.len
    while start < end && is_space(text[start]) { start += 1 }
    while end > start && is_space(text[end - 1]) { end -= 1 }
    return slice(text, start, end)
}

// The pieces between each `sep`. split("a,b,,c", ",") gives "a", "b", "", "c".
pub new function split(text: str, sep: str) -> List<str> {
    var parts = List<str>()
    if sep.len == 0 {
        parts.push(text)
        return parts
    }
    var start: uint = 0
    var i: uint = 0
    while i + sep.len <= text.len {
        if slice(text, i, i + sep.len) == sep {
            parts.push(slice(text, start, i))
            i += sep.len
            start = i
        } else {
            i += 1
        }
    }
    parts.push(slice(text, start, text.len))
    return parts
}

// A whole number like "42" or "-7", or None if the text isn't one (or is too big).
pub new function parse_int(text: str) -> Option<int> {
    if text.len == 0 { return None }
    var i: uint = 0
    var negative = false
    if text[0] == 45 {          // '-'
        negative = true
        i = 1
    } else if text[0] == 43 {   // '+'
        i = 1
    }
    if i == text.len { return None }
    var n = 0
    while i < text.len {
        let b = text[i]
        if b < 48 || b > 57 { return None }
        let digit = int(b) - 48
        if n > (9223372036854775807 - digit) / 10 { return None }
        n = n * 10 + digit
        i += 1
    }
    if negative { return Some(-n) }
    return Some(n)
}

// A number like "3.5", "-2", "1e9", or None.
pub new function parse_float(text: str) -> Option<float> {
    var v = 0.0
    if h2_parse_float(text.data, text.len, &v) { return Some(v) }
    return None
}
